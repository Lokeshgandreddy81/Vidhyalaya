# Vidhyalaya Frontend Environment Configuration Example

# URL of the backend API server. Defaults to http://localhost:5000/api if not specified.
VITE_API_URL=http://localhost:5000/api

# Optional: Default Gemini API Key to use in development (Bring-Your-Own-Key client mode).
# For production, it is recommended to set this key on the backend or let users configure it dynamically.
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini API Version override (default is 'v1beta')
# VITE_GEMINI_API_VERSION=v1beta

# Optional: Google Client ID for Google Login authentication
# VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
