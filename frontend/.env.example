# Vidhyalaya Frontend Environment Configuration Example
# Copy this file to .env and fill in your values.

# URL of the backend API server. Defaults to http://localhost:5001/api if not specified.
VITE_API_URL=http://localhost:5001/api

# Optional: Default Gemini API Key (Bring-Your-Own-Key client mode).
# Get your key at: https://aistudio.google.com/apikey
# Supports both AIzaSy… (AI Studio) and AQ.… (Google Cloud) key formats.
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Client ID for Google Login authentication
# Create at: https://console.cloud.google.com/apis/credentials
# VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
