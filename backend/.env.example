# MongoDB Atlas Connection String
# Get this from MongoDB Atlas: Connect -> Drivers -> Copy Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vidyal-ai?retryWrites=true&w=majority

# Server Configuration
PORT=5001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# ─── BYOK Key-at-Rest Encryption ─────────────────────────────────────────────
# Required. AES-256-GCM root secret for encrypting stored API keys.
# Generate a secure key with: node -e "require('crypto').randomBytes(32).toString('hex')"
# CAUTION: Losing this key = permanent loss of all stored BYOK configurations.
DB_ENCRYPTION_KEY=

# Google OAuth Client ID (required in production for Google SSO)
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here

# CORS - Frontend URL
FRONTEND_URL=http://localhost:3000

# YouTube Data API v3 — enables accurate video search, chapters, and metadata
# Create at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Gemini API (chapter/transcript fallbacks + content generation)
GEMINI_API_KEY=your_gemini_api_key_here

# LlamaCloud API Key for LlamaParse
LLAMAPARSE_API_KEY=your_llamacloud_api_key_here

# SMTP E-mail Configuration (Nodemailer fallback to console logs in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Vidhyalaya <noreply@vidyal.ai>"
