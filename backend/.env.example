# ─────────────────────────────────────────────────────────
#  Vidhyalaya / Cortex — Backend Environment Configuration
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────

# ── MongoDB Atlas ─────────────────────────────────────────
# Get connection string from: MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vidyal-ai?retryWrites=true&w=majority

# ── Server ────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
ALLOW_DEV_TOKEN=true

# ── CORS — frontend origin ────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── AI Keys ───────────────────────────────────────────────
# Gemini API Key — supports AIzaSy… (AI Studio) and AQ.… (Google Cloud) formats
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 — enables accurate video search, chapters & metadata
# Create at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# ── Auth ──────────────────────────────────────────────────
# Generate a secure JWT secret:
#   node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=your_jwt_secret_here

# Google OAuth Client ID (required in production for Google SSO)
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here

# ── BYOK Key-at-Rest Encryption ───────────────────────────
# Required. AES-256-GCM root secret for encrypting stored API keys.
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')"
# CAUTION: Losing this key = permanent loss of all stored BYOK configurations.
DB_ENCRYPTION_KEY=your_64_char_hex_key_here

# ── Email (choose ONE provider, leave others blank) ────────

# OPTION A — Resend (recommended, free 3000 emails/month)
# Sign up at https://resend.com → API Keys → Create API Key
RESEND_API_KEY=your_resend_api_key_here

# OPTION B — Gmail App Password (for personal/small scale)
# Generate at: myaccount.google.com → Security → App Passwords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Sender name shown in email client
EMAIL_FROM="Vidhyalaya <noreply@vidyal.ai>"
